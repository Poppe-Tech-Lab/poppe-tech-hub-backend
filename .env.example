# Variáveis de ambiente do ambiente local.
# Copie este arquivo para .env e troque os valores. O .env não é versionado.
#
# O arquivo .env é lido pelo docker compose e também pela aplicação
# (via spring.config.import em application.properties), então os mesmos
# valores servem para o banco e para o backend.

DB_NAME=techhub
DB_USERNAME=techhub
DB_PASSWORD=troque-por-uma-senha-local
DB_PORT=5432

# Habilita o cadastro direto de usuários apenas no ambiente local.
# O endpoint continua exigindo autenticação Basic. Não use em produção.
USER_DIRECT_REGISTRATION_ENABLED=true
